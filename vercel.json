{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?action=resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/oauth?action=resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth?action=metadata"
    },
    {
      "source": "/oauth/:action",
      "destination": "/api/oauth?action=:action"
    }
  ]
}
